//Print subarray with maximum subarray sum (extended version of above problem) - follow up
	public int maxSubArray(int[] nums) {
        int maxSum = Integer.MIN_VALUE;
	        int sum =0;
	        int start =-1,ansStart =-1,ansEnd = -1;
	        
	        for(int i =0;i<nums.length;i++) {
	        	if(sum == 0)start = i;
	        	sum+=nums[i];
	        	if(sum>maxSum)maxSum = sum;
	        	if(sum<0) {
	        		sum =0;
	        		ansStart=start;
	        		ansEnd = i;
	        	}
	        }
	        return maxSum;
