class Solution {
    public int maxSubArray(int[] nums) {
        //Optimal TC = O(N) SC = O(1) 
        //Kadane's Algo
		 int maxSum = Integer.MIN_VALUE;
		 int sum =0;
		 for(int i =0;i<nums.length;i++) {
			 sum+=nums[i];
			 if(sum>maxSum) {
				 maxSum = sum;
			 }
			 if(sum < 0) {
				 sum =0;
			 }
		 }
		 
		 return maxSum;
