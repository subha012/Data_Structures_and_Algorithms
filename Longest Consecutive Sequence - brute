/*
	take one value from array increase that by one then check if the element is present in the array if yes then increase the count and update the element by +1 do the proccess until if the element is not present in
	the array then take the next value from the array.  do the same process.
to check if the element is present in the array or not use a different method (linearSearch) to fetch if the value is there or not.
*/
class Solution {
    public boolean linearSearchA(int[] nums,int c) {
		 for(int i =0;i<nums.length;i++) {
			 if(nums[i] == c) {
				 return true;
			 }
		 }
		 return false;
	 }
	 public int longestConsecutive(int[] nums) {
// TC = O(N2) SC= O(1)
        if(nums.length == 0) return 0;
		 int longCount =1;
		 for(int i =0;i<nums.length;i++) {
			 int count =1;
			 int num = nums[i];
			 while(linearSearchA(nums,num+1) == true){
					 count++;
					 num+=1;				 
			 }
			 longCount = Math.max(count, longCount);
		 }
		 return longCount;
	 }
}
