class Solution {
    public boolean isCyclic(int v, int[][] edges) { 
//Using Kahn's Algo(topo sort)
		ArrayList<ArrayList<Integer>> adj = new ArrayList<>();//TC = O(V+E)
		for(int i = 0;i<v;i++) {
			adj.add(new ArrayList<Integer>());
		}
		for(int i = 0;i<edges.length;i++) {//TC = O(E)
			int u = edges[i][0];
			int v2 = edges[i][1];
			adj.get(u).add(v2);
		}
		
		int[] inDegree = new int[v];//TC = O(V)
		for(int i = 0; i < v; i++) {//TC = O(V+E)
            for(int it : adj.get(i)) {
                inDegree[it]++;
            }
        }
		Queue<Integer> q = new LinkedList<Integer>();//TC = O(V)
		for(int i = 0;i<v;i++) {//TC = O(V)
			if(inDegree[i] == 0) {
				q.add(i);
			}
		}
		int cnt = 0;
		while(!q.isEmpty()) {//TC = O(V+E)
			int node = q.poll();
			cnt++;
			for(int it: adj.get(node)) {
				inDegree[it]--;
				if(inDegree[it] == 0) {
					q.add(it);
				}
			}
		}
		if(cnt == v)return false;
		return true;
	}
