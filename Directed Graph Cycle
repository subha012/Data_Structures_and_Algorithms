class Solution {
    public boolean isCyclic(int v, int[][] edges) { 
        //TC = O(V) + O(E) + O(V+E) + O(E) = O(V+E)
        //SC = O(V)+O(v)+O(V) + O(V+E) = O(V+E)
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();//SC = O(V+E)
        for (int i = 0; i < v; i++) {//o(v)
            adj.add(new ArrayList<>());
        }

        for (int i = 0; i < edges.length; i++) {//o(e)
            adj.get(edges[i][0]).add(edges[i][1]);
        }
        int[] vis = new int[v];//o(v)
        int[] pathvis = new int[v];//O(V)
        for(int i =0;i<v;i++){//o(v)
            if(vis[i] == 0){
                if(dfs(i,adj,vis,pathvis) == true)return true;//o(v+e)
            }
        }
        return false;
    }
    public boolean dfs(int node,ArrayList<ArrayList<Integer>> adj,
    int[] vis,int[] pathvis){
        vis[node] = 1;
        pathvis[node] = 1;
        for(int it:adj.get(node)){//o(E)
            if(vis[it] == 0){
                if(dfs(it,adj,vis,pathvis) == true)return true;//SC = O(v) Recusion stack
            }
            else if(pathvis[it] == 1)return true;
        }
        pathvis[node] = 0;
        return false;
    }
}
