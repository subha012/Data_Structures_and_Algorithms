class Solution {
    public int countOccurrences(int[] arr, int target) {
        //BRUTE TC = O(N) SC  = O(1)
        /*int count = 0;
	        for(int i =0;i<arr.length;i++) {
	        	if(arr[i] == target)count++;
	        }
	        return count;*/
        //TC = O(LOGN) SC = O(1)
	        int low = 0,high = arr.length-1;
	        int result = firstOccurance(arr, target);
	        if(result == -1)return 0;
	        return lastOccurance(arr, target)-result+1;
    }
     private static int firstOccurance(int[] nums,int target) {
		 int n = nums.length;
		 int ans = -1;
		 int low = 0,high = n-1;
		 while(low<=high) {
			 int mid = (low+high)/2;
			 if(nums[mid] == target) {
				 ans = mid;
				 high = mid-1;				 
			 }else if(nums[mid] >target) high = mid-1;
			 else low = mid+1;
		 }
		 return ans;
	 }
	 private static int lastOccurance(int[] nums, int target) {			
		 int n = nums.length;
		 int ans = -1;
		 int low = 0,high = n-1;
		 while(low<=high) {
			 int mid = (low+high)/2;
			 if(nums[mid] == target) {
				 ans = mid;	
				 low=mid+1;
			 }
			 else if(nums[mid] >target)high = mid-1;
			 else low = mid+1;
		 }
		 return ans;
	 }
}
