class Solution {
    public List<Integer> majorityElement(int[] nums) {
        //Optimal 
        //there will be only 2 elements which have more occurance than n/3
        // So we will use moore algo
        int n = nums.length;
        int e1 = Integer.MIN_VALUE;
        int e2 = Integer.MIN_VALUE;
        int cnt1 =0,cnt2 = 0;
        for(int a:nums) {
        	if(a==e1)cnt1++;
        	else if(a == e2)cnt2++;
        	else if(cnt1 == 0) {
        		e1 = a;
        		cnt1++;
        	}
        	else if(cnt2 == 0) {
        		e2 =a;
        		cnt2++;
        	}
        	else {
        		cnt1--;
        		cnt2--;
        	}
        }
        //To varify that the element is having occurance more that n/3
        cnt1=0;
        cnt2=0;
        for(int a:nums) {
        	if(a == e1)cnt1++;
        	else if(a == e2)cnt2++;
        }
        
        List<Integer> list = new LinkedList<Integer>();
        int min = n/3+1;
        if(cnt1>=min)list.add(e1);
        if(cnt2>=min)list.add(e2);         	
    	return list;

        //Better TC = O(NLOGN) SC = O(N) - O(N) for uing a map data structure
        //O(N * logN), where N is size of the given array. For using a map data structure, where insertion in the map takes logN time
