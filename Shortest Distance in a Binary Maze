// User function Template for Java
class Triplet{
	int distance;
	int row;
	int col;
	public Triplet(int distance, int row, int col) {
		super();
		this.distance = distance;
		this.row = row;
		this.col = col;
	}
}
class Solution {
// tc = o(n*m*4) sc = o(n*m)
    int shortestPath(int[][] grid, int[] source, int[] destination) {
        if(source[0] == destination[0] && source[1] == destination[1])return 0;
        Queue<Triplet> q = new LinkedList<Triplet>();
        int n = grid.length;
        int m = grid[0].length;
        int[][] dist = new int[n][m];
        for(int i = 0;i<n;i++) {
        	for(int j = 0;j<m;j++) {
        		dist[i][j] = Integer.MAX_VALUE;
        	}
        }
        dist[source[0]][source[1]] = 0;
        q.add(new Triplet(0, source[0], source[1]));
        int delRow[] = {-1,0,1,0};
        int delCol[] = {0,1,0,-1};
        
        while(!q.isEmpty()) {
        	Triplet t = q.poll();
        	int dist1 = t.distance;
        	int row = t.row;
        	int col = t.col;
        	for(int i =0;i<4;i++) {
        		int nRow = row+delRow[i];
        		int nCol = col+delCol[i];
        		if(nRow>=0 && nCol>=0 && nRow<n && nCol<m &&
        				grid[nRow][nCol] == 1 && dist[nRow][nCol] > dist1+1) {
        			dist[nRow][nCol] = dist1+1;
        			if(nRow == destination[0] && nCol == destination[1])return dist1+1;
        			q.add(new Triplet(dist1+1, nRow, nCol));
        		}
        	}
        	
        }
        return -1;
    }
}
