class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        //OPtimal TC O(N+M) SC = O(1)

        int n = matrix.length;
        int m = matrix[0].length;
        int row =0,col = m-1;
        while(row<n && col>=0) {
        	if(matrix[row][col] == target)return true;
        	else if(matrix[row][col]<target)row++;
        	else col--;
        }
		
		return false;
