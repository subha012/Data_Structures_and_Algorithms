class Solution {
    
    public ArrayList<Integer> topoSort(int v, int[][] edges) {
        
        // Step 1: Create adjacency list
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();//SC = O(V+E)
        for(int i = 0; i < v; i++) {
            adj.add(new ArrayList<>());
        }
        
        // Step 2: Fill adjacency list from edges
        for(int i = 0; i < edges.length; i++) {//TC - O(E)
            int u = edges[i][0];
            int v2 = edges[i][1];
            adj.get(u).add(v2);
        }
        
        // Step 3: Calculate indegree
        int[] inDegree = new int[v];//SC = O(V)
        for(int i = 0; i < v; i++) {//TC - O(E)
            for(int it : adj.get(i)) {
                inDegree[it]++;
            }
        }
        
        // Step 4: Add nodes with indegree 0 to queue
        Queue<Integer> q = new LinkedList<>();//SC = O(V)
        for(int i = 0; i < v; i++) {//TC - O(V)
            if(inDegree[i] == 0) {
                q.add(i);
            }
        }
        
        // Step 5: BFS
        ArrayList<Integer> list = new ArrayList<>();//SC = O(V)
        while(!q.isEmpty()) {//TC - O(V+E)
            int node = q.poll();
            list.add(node);
            
            for(int it : adj.get(node)) {
                inDegree[it]--;
                if(inDegree[it] == 0) {
                    q.add(it);
                }
            }
        }
        
        return list;
    }
}
