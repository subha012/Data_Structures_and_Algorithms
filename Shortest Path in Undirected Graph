class Solution {
    public int[] shortestPath(int v, int[][] edges, int src) {
        ArrayList<ArrayList<Integer>> adj = new ArrayList<ArrayList<Integer>>();//SC = O(V+E)
        for(int i = 0;i<v;i++) {//TC = O(V)
        	adj.add(new ArrayList<Integer>());
        }
        for(int i = 0;i<edges.length;i++) {//TC = O(E)
        	adj.get(edges[i][0]).add(edges[i][1]);//Undirect graph so there will be both edges
        	adj.get(edges[i][1]).add(edges[i][0]);
        }
        int[] dist = new int[v];//SC = O(V)
        for(int i =0;i<v;i++) {//TC = O(V)
        	dist[i] = Integer.MAX_VALUE;
        }
        dist[src] = 0;//dist from itself is 0
        Queue<Integer> q = new LinkedList<Integer>();//SC = O(V)
        q.add(src);
        while(!q.isEmpty()) {//SC = O(V+E)
        	int node = q.poll();
        	for(int it:adj.get(node)) {
        		if(dist[node]+1<dist[it]) {
        			dist[it] = 1+dist[node];
        			q.add(it);
        		}
        	}
        }
        for(int i = 0;i<v;i++) {//TC = O(V)
        	if(dist[i] == Integer.MAX_VALUE)dist[i] = -1;
        }
        
       return dist; 
        
    }
}
