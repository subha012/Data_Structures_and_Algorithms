class Solution {
    public int majorityElement(int[] nums) {
        //OPtimal (best) TC = O(n) SC=O(1)
        int count =0;
        int candidate  = 0;
        for(int a:nums){
            if(count==0)candidate  = a;
            if(candidate  == a){
                count++;
            }else{
                count--;
            }
        }
        return candidate ;
