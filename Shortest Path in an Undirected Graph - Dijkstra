class Pair1 {
    int dist;
    int node;

    public Pair1(int dist, int node) {
        this.dist = dist;
        this.node = node;
    }
}

class Solution {

    public List<Integer> shortestPath(int n, int m, int edges[][]) {

        List<List<Pair1>> adj = new ArrayList<>();

        for(int i = 0; i <= n; i++) {
            adj.add(new ArrayList<>());
        }

        // ✅ FIXED adjacency
        for(int i = 0; i < m; i++) {

            int u = edges[i][0];
            int v = edges[i][1];
            int wt = edges[i][2];

            adj.get(u).add(new Pair1(wt, v));
            adj.get(v).add(new Pair1(wt, u));
        }

        PriorityQueue<Pair1> pq =
                new PriorityQueue<>((x,y) -> x.dist - y.dist);

        int[] dist = new int[n+1];
        int[] parent = new int[n+1];

        Arrays.fill(dist, Integer.MAX_VALUE);

        for(int i = 1; i <= n; i++)
            parent[i] = i;

        dist[1] = 0;
        pq.add(new Pair1(0, 1));

        while(!pq.isEmpty()) {

            Pair1 curr = pq.poll();
            int node = curr.node;
            int dis = curr.dist;

            // ✅ VERY IMPORTANT
            if(dis > dist[node]) continue;

            for(Pair1 it : adj.get(node)) {

                int adjNode = it.node;
                int weight = it.dist;

                if(dis + weight < dist[adjNode]) {

                    dist[adjNode] = dis + weight;
                    parent[adjNode] = node;

                    pq.add(new Pair1(dist[adjNode], adjNode));
                }
            }
        }

        List<Integer> path = new ArrayList<>();

        if(dist[n] == Integer.MAX_VALUE) {
            path.add(-1);
            return path;
        }

        int node = n;

        while(parent[node] != node) {
            path.add(node);
            node = parent[node];
        }

        path.add(1);
        Collections.reverse(path);
        path.add(0, dist[n]);
        return path;
    }
}
