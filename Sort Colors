class Solution {
    private void swap(int[] nums, int low, int mid) {
		 int temp = nums[mid];
		 nums[mid] = nums[low];
		 nums[low] = temp;
			
	}
    public void sortColors(int[] nums) {
        //optimal TC = O(n) Sc =o(1)
        int low=0,mid=0,high = nums.length-1;
		 while(mid<=high){
			 if(nums[mid] == 0) {
				 swap(nums,low,mid);
				 low++;
				 mid++;
			 }
			 else if(nums[mid] == 1)mid++;
			 else {// nums[mid] == 2
				 swap(nums,mid,high);
				 high--;
			 }
		 }

