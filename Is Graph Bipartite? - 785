class Solution {
    public boolean isBipartite(int[][] graph) {
        //TC = O(V+E) Because each vertex is visited once and each edge is processed once during BFS.
        //SC = O(V)
        int v = graph.length;
        int[] colors = new int[v];
        Arrays.fill(colors, -1);
        for(int i = 0;i<v;i++) {//O(V)
        	if(colors[i] == -1) {
        		Queue<Integer> q = new LinkedList<Integer>();//SC = O(V)
        		q.add(i);
        		colors[i] = 0;
        		while(!q.isEmpty()) {
        			int node = q.poll();
        			for(int neighbor:graph[node]) {//o(E)
        				if(colors[neighbor] == -1) {
        					colors[neighbor] = 1-colors[node];
        					q.add(neighbor);
        				}else if(colors[neighbor] == colors[node]) {
        					return false;
        				}
        			}
        		}
        	}
        	
        }
        
        return true;
    }
}
