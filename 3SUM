class Solution {
    public List<List<Integer>> threeSum(int[] nums) {
        //OPtimal TC = O(nlogn) +O(N2) 
        //Sorting: O(n log n)
        //Two-pointer search: O(n²)
        //Overall: O(n²)
        //Space Complexity:
        //Output storage: O(n²)
        //Extra space: O(log n) due to sorting
        List<List<Integer>> triplet = new LinkedList<List<Integer>>();
    	int n = nums.length;
    	Arrays.sort(nums);//TC - O(NLOGN)
    	for(int i =0;i<nums.length;i++) { //TC - O(N)
    		if(i>0 && nums[i] == nums[i-1])continue;
    		int j = i+1;
    		int k = n-1;
    		while(j<k) {//TC - O(N)
    			int sum = nums[i]+nums[j]+nums[k];
    			if(sum<0) j++;
    			else if(sum>0)k--;
    			else {
    				List<Integer> list = new LinkedList<Integer>();
    				list.add(nums[i]);
    				list.add(nums[j]);
    				list.add(nums[k]);
    				triplet.add(list);
    				j++;
    				k--;
    				while(j<k &&nums[j] == nums[j-1])j++; //
    				while(j<k && nums[k] == nums[k+1])k--;// for both is O(n) overall (pointers never move backward)
    				
    			}
    		}
    	}
        return triplet;

