/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    //Optimal TC = O(N) SC = O(H)
        TreeNode first = null;
	    TreeNode second = null;
	    TreeNode prev = null;

	    public void recoverTree(TreeNode root) {
	        inorder(root);

	        // swap values
	        int temp = first.val;
	        first.val = second.val;
	        second.val = temp;
	    }

	    private void inorder(TreeNode root) { // TC = O(N) SC = O(H)
	        if(root == null) return;

	        inorder(root.left);

	        if(prev != null && prev.val > root.val) {
	            if(first == null) {
	                first = prev;
	            }
	            second = root;
	        }

	        prev = root;

	        inorder(root.right);
	    }
	


