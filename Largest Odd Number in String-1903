class Solution {
    public String largestOddNumber(String num) {
        //Optimal TC = O(N) SC = O(1)
        int n = num.length();
		for(int i =n-1;i>=0;i--) {
			int digit = num.charAt(i)-'0';
			if(digit%2!=0)return num.substring(0,i+1);
		}
		return "";
        //Brute TC = O(N2) SC = O(1)
