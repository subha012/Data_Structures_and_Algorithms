class Solution {
    public static int[] reverse(int[] nums,int start,int end) {
		while(start<end){
			int temp =nums[start];
			nums[start] = nums[end];
			nums[end] = temp;
			start++;
			end--;
		}
		return nums;
	}
    public void rotate(int[] nums, int k) {

