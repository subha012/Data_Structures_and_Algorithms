    public int[] rotateToright(int[] nums){
        int j =1;
        int[] arr = new int[nums.length];//O(n) - sc
        arr[0] = nums[nums.length-1];
        for(int i =0;i<nums.length-1;i++){//O(n)
            arr[j] = nums[i];
            j++;
        }
        for(int i =0;i<nums.length;i++){//O(n)
            nums[i] = arr[i];
        }
        return nums;
    }
