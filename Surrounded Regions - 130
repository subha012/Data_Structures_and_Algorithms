class Solution {
    //TC = O(N*M) SC = O(N*M)
    public void solve(char[][] board) {
    	int n = board.length;
    	int m = board[0].length;
        int delRow[] = {-1,0,1,0};
        int delCol[] = {0,1,0,-1};
        int vis[][] = new int[n][m];//O(N*M)
        
        //traverse first row and lastrow
        for(int j = 0;j<m;j++) {//O(M)
        	//first row
        	if(vis[0][j] == 0 && board[0][j] == 'O') {
        		dfsSearch(0,j,board,vis,delRow,delCol);
        	}
        	//last row
        	if(vis[n-1][j] == 0 && board[n-1][j] == 'O') {
        		dfsSearch(n-1, j, board, vis, delRow, delCol);
        	}
        }
        
        //Traverse first col and last col
        for(int i = 0;i<n;i++) {//O(N)
        	if(vis[i][0] == 0 && board[i][0] == 'O') {
        		dfsSearch(i, 0, board, vis, delRow, delCol);
        	}
        	
        	if(vis[i][m-1] == 0 && board[i][m-1] == 'O') {
        		dfsSearch(i, m-1, board, vis, delRow, delCol);
        	}
        	
        }
        
        for(int i = 0;i<n;i++) {//O(N*M)
        	for(int j = 0;j<m;j++) {
        		if(vis[i][j] == 0 && board[i][j] == 'O') {
        			board[i][j] = 'X';
        		}
        	}
        }
        
    }

	private void dfsSearch(int row, int col, char[][] board, int[][] vis, int[] delRow, int[] delCol) {
		vis[row][col] = 1;
		int n = board.length;
		int m = board[0].length;
		
		for(int i = 0;i<4;i++) {//O(4)
			int nRow = row+delRow[i];
			int nCol = col+delCol[i];
			if(nRow>=0 && nCol>=0 && nRow<n && nCol<m && vis[nRow][nCol] == 0 && board[nRow][nCol] == 'O') {
				dfsSearch(nRow, nCol, board, vis, delRow, delCol);// o(n*m)
			}
					
		}
		
	}
}
