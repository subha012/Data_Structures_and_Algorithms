package IntroductionDP;

public class Recursion {

	public static void main(String[] args) {
		String s= "A man, a plan, a canal: Panama";
		System.out.println(isPalindrome(s));
	}
	public static boolean isPalindrome(String s) {
		s=s.toLowerCase();
	    String s1 = "";
	    for(int i = 0;i<s.length();i++) {
	    	if((s.charAt(i) >=48 &&s.charAt(i)<=57) ||(s.charAt(i) >=97 &&s.charAt(i)<=122)
	    			||(s.charAt(i) >=65 &&s.charAt(i)<=90)) {
	    		s1+=s.charAt(i);
	    	}
	    }
		return reverseString(s1.toCharArray(),0);
		
	     
    }

	private static boolean reverseString(char[] c, int i) {
		if(i>=c.length/2)return true;
		if(c[i]!=c[c.length/2-i-1])return false;
		return reverseString(c, i+1);
		
				
	}
	//using single parameter
	private static void reverse(int[] arr, int i) {
		if(i >= arr.length/2)return;
		int temp = arr[i];
		arr[i] = arr[arr.length-i-1];
		arr[arr.length-i-1] = temp;
		reverse(arr, i+1);
	}
	//using 2 parameter	
	private static void reverse(int[] arr, int i, int j) {
		if(i >= j)return;
		int temp = arr[i];
		arr[i] = arr[j];
		arr[j] = temp;
		reverse(arr, i+1, j-1);
	}
	//Parameterized
	private static int factorial(int n, int i) {
		if(n<1)return i;
		return factorial(n-1,i*n);
	}
	//Funtional way
	private static int factorial(int n) {
		if(n<1)return 1;
		return n*factorial(n-1);
	}

	private static void printNto1backtracking(int i, int n) {
		if(i>n)return;
		printNto1backtracking(i+1, n);
		System.out.println(i);
	}

	private static void print1toNbacktracking(int n, int n2) {
		if(n == 0)return;
		print1toNbacktracking(n-1, n2);
		System.out.println(n);
		
	}

	private static void print1ToNLinear(int n) {
		if(n==0)return;
		System.out.println(n);	
		n--;
		print1ToNLinear(n);
		
		
	}

	private static void printNameNtimes(String name, int n) {
		if(n == 0)return;
		System.out.println(name);
		n--;
		printNameNtimes(name, n);
	}
	
	//functional way 
	private static int sumFirstNnumFun(int n) {
		if(n<1)return 0;
		return n+sumFirstNnumFun(n-1);
	}
	//Parameterized way
	private static int sumOfFirstNnumbers(int sum, int n) {
		if(n<1)return sum;
		sum += n;
		return sumOfFirstNnumbers(sum, n-1);		
	}

}
