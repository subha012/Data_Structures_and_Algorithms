class Solution {
    public int[] bellmanFord(int v, int[][] edges, int src) {
        int[] dist = new int[v];
		Arrays.fill(dist, (int)1e8);
		dist[src] = 0;
		//relax all the edges v-1 times
		for(int i = 0;i<v-1;i++) {
			for(int j = 0;j<edges.length;j++) {
				int u = edges[j][0];
				int v1 = edges[j][1];
				int wt = edges[j][2];
				if(dist[u] != (int)1e8 && (dist[u]+wt<dist[v1])) {
					dist[v1] = dist[u]+wt;
				}
			}
		}
		//Detect -ve cycle
		for(int i = 0;i<edges.length;i++) {
			int u = edges[i][0];
			int v1 = edges[i][1];
			int wt = edges[i][2];
			if(dist[u] != (int)1e8 && (dist[u]+wt<dist[v1])){
				return new int[] {-1};
			}
		}
		
		return dist;
    }
}
