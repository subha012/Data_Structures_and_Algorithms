import java.util.*;

class Solution {

    int countDistinctIslands(int[][] grid) {
        int n = grid.length;
        int m = grid[0].length;

        int[][] vis = new int[n][m];
        HashSet<ArrayList<String>> set = new HashSet<>();

        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                if(grid[i][j] == 1 && vis[i][j] == 0) {

                    ArrayList<String> list = new ArrayList<>();
                    dfs(i, j, vis, grid, list, i, j);
                    set.add(list);
                }
            }
        }
        return set.size();
    }

    private void dfs(int row, int col, int[][] vis, int[][] grid,
                     ArrayList<String> list,
                     int rowOrigin, int colOrigin) {

        vis[row][col] = 1;

        list.add((row - rowOrigin) + "," + (col - colOrigin));

        int n = grid.length;
        int m = grid[0].length;

        int[] delRow = {-1, 0, 1, 0};
        int[] delCol = {0, 1, 0, -1};

        for(int i = 0; i < 4; i++) {

            int nRow = row + delRow[i];
            int nCol = col + delCol[i];

            if(nRow >= 0 && nCol >= 0 && nRow < n && nCol < m &&
               vis[nRow][nCol] == 0 && grid[nRow][nCol] == 1) {

                dfs(nRow, nCol, vis, grid, list, rowOrigin, colOrigin);
            }
        }
    }
}
