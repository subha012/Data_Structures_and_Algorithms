class Solution {
    private long power(int base,int exp,int limit) {
		long ans = 1;
		for(int i = 0;i<exp;i++) {
			ans*=base;
			if(ans>limit)return ans;
		}
		return ans;
	}
    
	public int NthRoot(int N, int M) {
        //OPtimal TC = O(NlogM) SC = O(1)
        int low = 1;
        int high = M;
        while(low<=high){
        	int mid = low+(high-low)/2;
        	long pow = power(mid,N,M);
        	if(pow == M)return mid;
        	else if(pow>M)high = mid-1;
        	else {
        		low = mid+1;
        	}
        }
		return -1;

        //Brute force   TC = O(M*N) SC =O(1)
        /*for(int i =1;i<=M;i++) {
            long pow = power(i,N,M);
        	if(a == M)return i;
            if(a > M)break;
        }
		return -1;*/
    }
}


