class Solution {
    private int getmax(int[] piles) { // TC - O(N)
		int max = Integer.MIN_VALUE;
		for(int i = 0;i<piles.length;i++) {
			if(max<piles[i])max = piles[i];
		}
		return max;
	}
	private int calHours(int[] piles, int i) { // TC - O(N)
		int hours = 0;
		for(int j =0;j<piles.length;j++) {
			hours+=Math.ceil((double)piles[j]/i);
		}
		return hours;
	}
	public int minEatingSpeed(int[] piles, int h) {
        //OPtimal TC = O(NlogMax) sc = o(1)
        int reqTime = 0;
        int max = getmax(piles);
        int low = 1,high = max;
        while(low<=high) {
        	int mid = low +(high-low)/2;
        	reqTime = calHours(piles,mid);//o(n) -tc
        	if(reqTime <= h) high = mid-1;
        	else {
        		low = mid+1;
        	}
        }
        return low;
        //Brute TC = O(N*MAX) +O(N) =~ O(n*max) sc = O(1)
