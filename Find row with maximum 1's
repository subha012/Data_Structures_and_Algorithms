	private static int lowerBound(int[] mat, int i) {
		int low = 0,high = mat.length-1;
		int ans = mat.length;
		while(low<=high) {
			int mid = low+(high-low)/2;
			if(mat[mid]==i) {
				ans = mid;
				high = mid-1;
			}else {
				low = mid+1;
			}
		}
		return ans;
	}
