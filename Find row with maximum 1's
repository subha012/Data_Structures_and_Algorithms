public static int rowWithMax1s(int[][] mat) {
		//Optimal  TC = O(N*logM) SC = O(1)
		int maxCount = 0;
		int index = -1;
		for(int i =0;i<mat.length;i++) {
			int OneCount = mat[i].length - lowerBound(mat[i],1);
			
			if(OneCount>maxCount) {
				maxCount = OneCount;
				index = i;				
			}
		}
		return index;
