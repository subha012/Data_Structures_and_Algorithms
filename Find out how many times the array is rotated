class Solution {
    public int findKRotation(ArrayList<Integer> nums) {
        //Optimal TC = O(LOGN) SC = O(1)
        int ans = Integer.MAX_VALUE;
        int low = 0,high = nums.size()-1;
        int index = -1;
        while(low<=high) {
        	int mid = low+(high-low)/2;
        	if(nums.get(low)<=nums.get(mid)) {
        		if (nums.get(low) < ans) {
                    ans = nums.get(low);
                    index = low;
                }
                low = mid + 1;
        	}else {
        		if (nums.get(mid) < ans) {
                    ans = nums.get(mid);
                    index = mid;
                }
        		high=mid-1;
        	}
        }
		return index;
        //Brute TC = O(N) SC = O (1)
        /*int ans = Integer.MAX_VALUE;
        int index = -1;        
        for(int i =0;i<nums.size();i++) {
        	if(nums.get(i)<ans){
                ans = nums.get(i);
                index = i;
            }
        }
        return index;*/
    }
}
