class Solution {
    public int maxProfit(int[] prices) {
        //Optimal TC = O(n) SC= O(1)
        int mini = prices[0];
        int maxProfit =0;
        for(int i =0;i<prices.length;i++){
            int cost = prices[i] - mini;
            maxProfit= Math.max(maxProfit, cost);
            mini = Math.min(prices[i],mini);

        }
        return maxProfit;

