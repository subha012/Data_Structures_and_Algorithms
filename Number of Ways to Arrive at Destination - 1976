class Pair3{
	long dist;
	int node;
	public Pair3( int node,long dist) {
		super();
		this.dist = dist;
		this.node = node;
	}
	
}
class Triplet2{
	long distance;
	int node;
	public Triplet2(long distance, int node) {
		super();
		this.distance = distance;
		this.node = node;
	}
}
class Solution {
    public int countPaths(int n, int[][] roads) {
        int MOD = (int)1e9 + 7;// return it modulo 109 + 7.
        ArrayList<ArrayList<Pair3>> adj = new ArrayList<ArrayList<Pair3>>();
        for(int i = 0;i<n;i++) {
        	adj.add(new ArrayList<Pair3>());
        }
        for(int i = 0;i<roads.length;i++) {
        	int u = roads[i][0];
        	int v = roads[i][1];
        	int wt = roads[i][2];
        	adj.get(u).add(new Pair3(v, wt));
        	adj.get(v).add(new Pair3(u, wt));
        }
        PriorityQueue<Triplet2> pq = new PriorityQueue<Triplet2>((x,y)->Long.compare(x.distance,y.distance));
        long[] dist = new long[n];
        long[] ways = new long[n];
        Arrays.fill(dist, Long.MAX_VALUE);
        dist[0] = 0;
        ways[0] = 1;
        pq.add(new Triplet2(0, 0));
        while(!pq.isEmpty()) {
        	Triplet2 t = pq.poll();
        	long dis = t.distance;
        	int node = t.node;
            if(dis > dist[node]) continue;
        	for(Pair3 it:adj.get(node)) {
        		int adjNode = it.node;
        		long adjDist = it.dist;
        		if(dis+adjDist<dist[adjNode]) {
        			dist[adjNode] = dis+adjDist;
                    ways[adjNode] = ways[node];
        			pq.add(new Triplet2(dis+adjDist,adjNode));
        		}else if(dist[adjNode] == dis+adjDist) {
        			ways[adjNode] = (ways[adjNode] + ways[node]) % MOD;
        		}
        	}
        			
        }
        return (int)(ways[n-1] % MOD);
    }
}
