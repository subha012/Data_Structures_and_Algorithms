class Disjoint{
	List<Integer> parent = new ArrayList<Integer>();
	List<Integer> size = new ArrayList<Integer>();
	Disjoint(int n){
		for(int i = 0;i<=n;i++) {//<= n because it can be 1 based indexing so in this way it will work for both based indexing
			parent.add(i);
			size.add(1);// as size of each node is 1
		}
	}
	
	public int findUParent(int node) {
		if(node == parent.get(node)) {
			return node;
		}
		int up = findUParent(parent.get(node));
		parent.set(node, up);
		return parent.get(node);
	}
	void unionBySize(int u,int v) {
		int pu = findUParent(u);
		int pv = findUParent(v);
		if(pu == pv)return;
		if(size.get(pu)<size.get(pv)) {
			parent.set(pu, pv);
			size.set(pv, size.get(pu)+size.get(pv));
		}else {
			parent.set(pv, pu);
			size.set(pu, size.get(pu)+size.get(pv));
		}
	}
	
}
class Solution {
    public int largestIsland(int[][] grid) {
        int n = grid.length;
        Disjoint ds = new Disjoint(n*n);// as 2D matrix n*n
        //Step - 1 - create the graph by size and have the parents
        for(int i = 0;i<n;i++) {// TC = O(N*N*4)
        	for(int j = 0;j<n;j++) {
        		if(grid[i][j] == 0)continue;
        		int delRow[] = {-1,0,1,0};
        		int delCol[] = {0,1,0,-1};
        		for(int k = 0;k<4;k++) {
        			int nRow = delRow[k]+i;
        			int nCol = delCol[k]+j;
        			if(nRow>=0 && nCol >= 0 && nRow < n && nCol < n) {
        				if(grid[nRow][nCol] == 1) {
        					int nodeNo = i*n+j;
        					int adjNode = nRow*n +nCol;
        					ds.unionBySize(nodeNo, adjNode);
        				}
        			}
        		}
        	}        	
        }
        //Step -2 - if the parent is same in any direction then add one size to set
        int max = 0;
        for(int row = 0;row<n;row++) {// TC = O(N*N*4)
        	for(int col = 0;col<n;col++) {
        		if(grid[row][col] == 1)continue;
        		int delRow[] = {-1,0,1,0};
        		int delCol[] = {0,1,0,-1};
                //SC - O(4)
        		HashSet<Integer> set = new HashSet<Integer>();//edge case- used set to not get duplicate  if in all 4 directions we have one but 0 is inside if we will not use set then it will count for all the 4 directions individually
        		for(int k = 0;k<4;k++) {
        			int nRow = delRow[k]+row;
        			int nCol = delCol[k]+col;
        			if(nRow>=0 && nCol >= 0 && nRow < n && nCol < n) {
        				if(grid[nRow][nCol] == 1) {
        					set.add(ds.findUParent(nRow*n+nCol));
        				}
        			}
        		}
        		int size = 0;
        		for(Integer p: set) {//TC = O(SET.LENGTH)
        			size+=ds.size.get(p);
        		}
        		max = Math.max(max, size+1);
        	}
        }
        // if all the cell is 1 then
        for(int cellNo = 0;cellNo<n*n;cellNo++) {// TC = O(N*N)
        	max = Math.max(max, ds.size.get(ds.findUParent(cellNo)));
        }
        return max;
    }
}
