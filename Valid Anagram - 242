class Solution {
    public boolean isAnagram(String s, String t) {
        //Optimal TC = O(2N) SC = O(26) Frequency Count
		 if(s.length() != t.length())return false;
		 int[] count = new int[26];
		 for(int i =0;i<s.length();i++) {
			 count[s.charAt(i)-'a']++;
			 count[t.charAt(i)-'a']--;
		 }
		 for(int c:count) {
			 if(c != 0)return false;
		 }
		 return true;
		 
		 //Brute TC = O(nlogn) SC = O(2N)
		 /*if(s.length() != t.length())return false;
		 char[] a = s.toCharArray();//sc = o(n)
		 char[] b = t.toCharArray();//sc = o(n)
