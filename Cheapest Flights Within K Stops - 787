class Pair2{
	int u;
	int v;
	public Pair2(int u, int v) {
		super();
		this.u = u;
		this.v = v;
	}
}

class Triplet1{
	int stops;
	int node;
	int distance;
	public Triplet1(int stops, int node, int distance) {
		super();
		this.stops = stops;
		this.node = node;
		this.distance = distance;
	}
}
class Solution {
    public int findCheapestPrice(int n, int[][] flights, int src, int dst, int k) {
         ArrayList<ArrayList<Pair2>> adj = new ArrayList<ArrayList<Pair2>>();
        for(int i =0;i<n;i++) {
        	adj.add(new ArrayList<Pair2>());
        }
        for(int i = 0;i<flights.length;i++) {
        	adj.get(flights[i][0]).add(new Pair2(flights[i][1],flights[i][2]));
        }
        
        Queue<Triplet1> q = new LinkedList<Triplet1>();
        int[] dist = new int[n];
        q.add(new Triplet1(0, src, 0));
        for(int i = 0;i<n;i++) {
        	dist[i] = Integer.MAX_VALUE;
        }
        dist[src] = 0;
        while(!q.isEmpty()) {
        	Triplet1 t  = q.poll();
        	int stops = t.stops;
        	int node = t.node;
        	int cost = t.distance;
        	if(stops == k+1)break;
        	for(Pair2 pt: adj.get(node)) {
        		int adjNode = pt.u;
        		int price = pt.v;
        		if(cost+price<dist[adjNode]) {
        			dist[adjNode] = cost+price;
        			q.add(new Triplet1(stops+1, adjNode, cost+price));
        		}
        	}
        }
        
        if(dist[dst] == Integer.MAX_VALUE)return -1;
        return dist[dst];
    }
}
