/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    //OPtimal  TC = O(N) SC = O(H)
    public boolean findTarget(TreeNode root, int k) {
		if(root == null)return false;
		Stack<TreeNode> leftStack = new Stack<TreeNode>();//SC = O(H)
		Stack<TreeNode> rightStack = new Stack<TreeNode>();//SC = O(H)
		
		pushToLeft(root,leftStack); // TC = O(H)
		pushToRight(root,rightStack); //TC = O(H)
		
		while(!leftStack.isEmpty() && !rightStack.isEmpty() && leftStack.peek() != rightStack.peek()) {//TC = O(N)
			int leftVal = leftStack.peek().val;
			int rightVal = rightStack.peek().val;
			int sum = leftVal+rightVal;
			
			if(sum == k)return true;
			else if(sum<k) {
				next(leftStack);
			}else {
				before(rightStack);
			}
		}
		
		return false;
	}

	private void before(Stack<TreeNode> rightStack) {
		TreeNode node = rightStack.pop();
		pushToRight(node.left, rightStack);
		
	}

	private void next(Stack<TreeNode> leftStack) {
		TreeNode node = leftStack.pop();
		pushToLeft(node.right, leftStack);
		
	}

	private void pushToRight(TreeNode root, Stack<TreeNode> rightStack) {
		while(root!=null) {
			rightStack.push(root);
			root = root.right;
		}
		
	}

	private void pushToLeft(TreeNode root, Stack<TreeNode> leftStack) {
		while(root!=null) {
			leftStack.push(root);
			root = root.left;
		}
		
	}
