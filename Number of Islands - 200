class Solution {
    //OPtimal TC = O(N*M) SC = O(N*M) [RECURSION STACK]
    public int numIslands(char[][] grid) {
        int count = 0;
        if(grid == null || grid.length == 0)return 0;
        int n = grid.length;
        int m = grid[0].length;
        for(int i = 0;i<n;i++) {
        	for(int j = 0;j<m;j++) {
        		if(grid[i][j] == '1' ) {
        			count++;
        			dfs(grid,i,j);
        		}
        	}
        }
        return count;
    }
	private void dfs(char[][] grid, int i, int j) {
		
		int n = grid.length;
        int m = grid[0].length;
        if(i<0 || j<0 || i>=n || j>= m || grid[i][j] == '0' )return;
        grid[i][j] = '0';
        dfs(grid,i+1,j);
        dfs(grid,i-1,j);
        dfs(grid,i,j+1);
        dfs(grid,i,j-1);	
	}
