import java.util.*;
class Disjoint{
	List<Integer> parent = new ArrayList<Integer>();
	List<Integer> size = new ArrayList<Integer>();
	Disjoint(int n){
		for(int i = 0;i<=n;i++) {//<= n because it can be 1 based indexing so in this way it will work for both based indexing
			
			parent.add(i);
			size.add(1);// as size of each node is 1
		}
	}
	
	public int findUParent(int node) {
		if(node == parent.get(node)) {
			return node;
		}
		int up = findUParent(parent.get(node));
		parent.set(node, up);
		return parent.get(node);
	}
	
	void unionBySize(int u,int v) {
		int pu = findUParent(u);
		int pv = findUParent(v);
		if(pu == pv)return;
		if(size.get(pu)<size.get(pv)) {
			parent.set(pu, pv);
			size.set(pv, size.get(pu)+size.get(pv));
		}else {
			parent.set(pv, pu);
			size.set(pu, size.get(pu)+size.get(pv));
		}
	}
	
}
public class Solution {
    public static int[] numOfIslandsII(int n, int m, int[][] q) {
        Disjoint ds = new Disjoint(n*m);
        int[][] vis = new int[n][m];
        int count = 0;
        int len = q.length;
        int[] ans = new int[len];
        for(int i = 0;i<len;i++) {
        	int row = q[i][0];
        	int col = q[i][1];
        	if(vis[row][col] == 1) {
        		ans[i] = count;
        		continue;
        	}
        	vis[row][col] = 1;
        	count++;
        	int delRow[]= {-1,0,1,0};
        	int delCol[] = {0,1,0,-1};
        	for(int j = 0;j<4;j++) {
        		int nRow = row+delRow[j];
        		int nCol = col+delCol[j];
        		if(nRow>=0 && nCol>=0 && nRow<n&&nCol<m) {
        			if(vis[nRow][nCol] == 1) {
        				int nodeNo = row*m+col;
        				int adjNodeNo = nRow*m+nCol;
        				if(ds.findUParent(adjNodeNo) != ds.findUParent(nodeNo)) {
        					count--;
        					ds.unionBySize(nodeNo, adjNodeNo);
        				}
        			}
        		}
        	}
        	ans[i] = count;
        }
        return ans;
    }
}
