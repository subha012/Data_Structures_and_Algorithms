class Pair{
	String word;
	int level;
	public Pair(String word, int level) {
		super();
		this.word = word;
		this.level = level;
	}
}
/* change each char of each word and if will do level wise then if we found the endWord then return the level
Took a set to not have duplicates and will reduce the TC and SC
Used BFS Algo
*/
class Solution {
    //TC =O(N * word.length * 26) SC = O(N)
    public int ladderLength(String beginWord, String endWord, List<String> wordList) {
        Queue<Pair> q = new LinkedList<Pair>();//SC = O(N) WORDLIST LENGTH
        q.add(new Pair(beginWord,1));
        int n = wordList.size();
        Set<String> set = new HashSet<String>();//SC = O(N) WORDLIST LENGTH
        for(int i = 0;i<n;i++) {//TC = O(N)
        	set.add(wordList.get(i));
        }
        set.remove(beginWord);
        //TC = wordlist.length * 26 * word.length(Queue may have wordlist.length number of values)
        while(!q.isEmpty()) {
        	String word = q.peek().word;
        	int level = q.peek().level;
        	q.poll();
        	
        	if(word.equals(endWord))return level;
        	
        	for(int i = 0;i<word.length();i++) {//word.length
        		for(char ch = 'a' ; ch<='z';ch++) {//26
        			char replace[]= word.toCharArray();
        			replace[i] = ch;
        			String replacedWord = new String(replace);
        			if(set.contains(replacedWord)) {
        				set.remove(replacedWord);
        				q.add(new Pair(replacedWord,level+1));
        			}
        		}
        	}
        }
		return 0;
    }
}
