    class Solution {
        public int minDays(int[] bloomDay, int m, int k) {
            //OPtimal TC = O(N) + O(N) + (O(log(max − min)) *O(N)) = O(log(max-min+1) * N) SC = O(1)
            if((long)m*k>bloomDay.length)return -1;
            int min = getMin(bloomDay); //TC =O(N)
            int max = getMax(bloomDay);//TC =O(N)
            int ans =0;
            while(min<=max) {//log2(max − min + 1)
                int mid = min +(max-min)/2;
                int noOfBou = getBouquets(bloomDay,mid,m,k);//TC =O(N)
                if(noOfBou >= m) {
                    ans = mid;
                    max=mid-1;
                }
                else min = mid+1;
                
            }
            return ans;
            //TC = O(N) +O(N) +(O(max − min + 1)*O(N)) ~ O((MAX-MIN)*N) SC = O(1)
            /*int min = getMin(bloomDay);//O(N) - TC
            int max = getMax(bloomDay);//O(N) - TC
            for(int i = min ;i<=max;i++) {//O(max − min + 1) -TC
                int noOfBou = getBouquets(bloomDay,i,m,k);//O(N) - TC
                if(noOfBou == m)return i;
            }
            return -1;*/
        }
        
        private int getBouquets(int[] bloomDay, int min, int m, int k) {
            int countFlw = 0;
            int countBou =0;
            for(int i = 0;i<bloomDay.length;i++) {//O(N) - TC
                if(bloomDay[i]<=min) {
                    countFlw++;
                    if(countFlw == k && countBou <m) {
                        countBou++;
                        countFlw =0;
                    }
                }else {
                    countFlw = 0;
                }
            }
            return countBou;
        }
        private int getMax(int[] bloomDay) {
            int max = Integer.MIN_VALUE;
            for(int i =0;i<bloomDay.length;i++) {//O(N) - TC
                if(max<bloomDay[i])max = bloomDay[i];
            }
            return max;
        }
        private int getMin(int[] bloomDay) {
            int min = Integer.MAX_VALUE;
            for(int i =0;i<bloomDay.length;i++) {//O(N) - TC
                if(min>bloomDay[i])min = bloomDay[i];
            }
            return min;
        }
    }
