class Solution {
    public int mySqrt(int x) {
        //Optimal TC = O(logN) SC = O(1)
        int low = 1,high = x;
        while(low<=high) {
        	int mid = low +(high-low)/2;
        	long val = (long)mid*(long)mid;
        	if(val <= (long)x) {
        		low = mid+1; //if the multiplecation value is <= then move the low to right 
        	}
            else {
                high = mid-1; // the val is greater that X then move to left
            }
        }
        return high;
