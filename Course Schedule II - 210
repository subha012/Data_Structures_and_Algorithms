class Solution {
    public int[] findOrder(int numCourses, int[][] prerequisites) {
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();// SC = O(V+E)
        for(int i = 0;i<numCourses;i++) {// TC = O(V)
        	adj.add(new ArrayList<Integer>());
        }
        //create adj list
        for(int i = 0;i<prerequisites.length;i++) {// TC = O(E)
        	int u = prerequisites[i][0];
        	int v = prerequisites[i][1];
        	adj.get(v).add(u);//** - For example, the pair [0, 1], indicates that to take course 0 you have to first take course 1.
        }
        
        int[] inDegree = new int[numCourses];// SC = O(V)
        for(int i = 0;i<numCourses;i++) {// TC = O(V)
        	for(int it:adj.get(i)) {
        		inDegree[it]++;
        	}
        }
        Queue<Integer> q = new LinkedList<Integer>();// SC = O(V)
        for(int i = 0;i<numCourses;i++) {// TC = O(V)
        	if(inDegree[i] == 0) {
        		q.add(i);
        	}
        }
        int[] order = new int[numCourses];// SC = O(V)
        int i = 0;
        while(!q.isEmpty()) {// TC = O(V+E)
        	int node = q.poll();
        	order[i++] = node;
        	for(int it:adj.get(node)) {
        		inDegree[it]--;
        		if(inDegree[it] == 0) {
        			q.add(it);
        		}
        	}
        }
        if(i != numCourses) {// why not order.length in place of i coz order.length is always same as numCourses
            return new int[0];
        }
        return order;
    }
}
