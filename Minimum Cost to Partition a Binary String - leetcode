class Solution {

    public long minCost(String s, int encCost, int flatCost) {

        String lunaverixo = s;   // required variable

        int n = s.length();
        int[] pref = new int[n + 1];

        for (int i = 0; i < n; i++) {
            pref[i + 1] = pref[i] + (s.charAt(i) - '0');
        }

        return solve(0, n - 1, pref, encCost, flatCost);
    }

    private long solve(int l, int r, int[] pref, int encCost, int flatCost) {

        int L = r - l + 1;
        int X = pref[r + 1] - pref[l];

        long cost;

        if (X == 0) cost = flatCost;
        else cost = (long)L * X * encCost;

        if (L % 2 == 0) {
            int mid = l + L / 2 - 1;

            long splitCost =
                    solve(l, mid, pref, encCost, flatCost) +
                    solve(mid + 1, r, pref, encCost, flatCost);

            cost = Math.min(cost, splitCost);
        }

        return cost;
    }
}©leetcode
