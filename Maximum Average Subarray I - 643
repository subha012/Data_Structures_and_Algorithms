class Solution {
    public double findMaxAverage(int[] nums, int k) {
        //optimal
        double max = Double.NEGATIVE_INFINITY;//smaller than any possible number.
		int left =0;
		int count = 1;
		double sum =0;
		for(int right = 0;right<nums.length;right++) {
			sum+=nums[right];
			if(right-left+1>k) {
				sum -=nums[left];
				left++;
			}
			if(right-left+1 == k) {
				max=Math.max(max, sum);
			}		
		}
		return max/k;
