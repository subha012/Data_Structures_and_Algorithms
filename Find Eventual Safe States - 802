class Solution {
    public List<Integer> eventualSafeNodes(int[][] graph) {
	        int v = graph.length;
	        LinkedList<ArrayList<Integer>> adj = new LinkedList<>();
	        for(int i = 0;i<v;i++) {
	        	adj.add(new ArrayList<Integer>());
	        }
	        for(int i = 0; i < v; i++) {
                for(int it : graph[i]) {
                    adj.get(i).add(it);
                }
            }

	        
	        int[] vis = new int[v];
	        int[] pathVis = new int[v];
	        int[] check = new int[v];
	        
	        for(int i = 0;i<v;i++) {
	        	if(vis[i] == 0) {
	        		dfsSafe(i,adj,vis,pathVis,check);
	        	}
	        }
	        List<Integer> safe = new ArrayList<Integer>();
	        for(int i =0;i<v;i++) {
	        	if(check[i] == 1) {
	        		safe.add(i);
	        	}
	        }
	        return safe;
	        
	 }

	private boolean dfsSafe(int node, LinkedList<ArrayList<Integer>> adj, int[] vis, int[] pathVis, int[] check) {
		vis[node] = 1;
		pathVis[node] = 1;
		check[node] = 0;
		for(int i:adj.get(node)) {
			if(vis[i] == 0) {
				if(dfsSafe(i, adj, vis, pathVis, check)) {
					return true;
				}
			}
			else if(pathVis[i] == 1)return true;
		}
		pathVis[node] = 0;
		check[node] = 1;
		return false;
		
		
	}
}
