class Solution {
    public int[] searchRange(int[] nums, int target) {
        //Brute  TC = O(N) SC = O(1)
        /*int ans[] = {-1,-1};
		 for(int i =0;i<nums.length;i++) {
			 if(nums[i] == target) {
				 if(ans[0] == -1) ans[0] = i;
				 ans[1] = i;
			 }			 
		 }
		 return ans;*/
         //Optimal TC = O(LOGN) SC = O(1)
          int ans[] = {-1,-1};
		 ans[0] = firstOccurance(nums, target);
		 ans[1] = lastOccurance(nums,target);
		 return ans;
	 }
	 
	 private static int firstOccurance(int[] nums,int target) {
		 int n = nums.length;
		 int ans = -1;
		 int low = 0,high = n-1;
		 while(low<=high) {
			 int mid = (low+high)/2;
			 if(nums[mid] == target) {
				 ans = mid;
				 high = mid-1;				 
			 }else if(nums[mid] >target) high = mid-1;
			 else low = mid+1;
		 }
		 return ans;
	 }
	 private static int lastOccurance(int[] nums, int target) {			
		 int n = nums.length;
		 int ans = -1;
		 int low = 0,high = n-1;
		 while(low<=high) {
			 int mid = (low+high)/2;
			 if(nums[mid] == target) {
				 ans = mid;	
				 low=mid+1;
			 }
			 else if(nums[mid] >target)high = mid-1;
			 else low = mid+1;
		 }
		 return ans;
	 }
}
