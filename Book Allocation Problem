	 }
	
	private int getCntStudent(int[] nums, int max) {
		int stu = 1,pagesPerStu = 0;
		for(int i = 0;i<nums.length;i++) {
			if(pagesPerStu+nums[i]<=max) {
				pagesPerStu+=nums[i];
			}else {
				stu++;
				pagesPerStu = nums[i];
			}
		}
		return stu;
	}
}
