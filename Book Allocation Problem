class Solution {

    public int findPages(int[] nums, int m) {

//OPtimal TC = O(N) +(O(log(MAX-MIN+1)*O(N)) SC = O(1)
		int max = 0,sum =0;
		for(int i =0;i<nums.length;i++) {
			if(max<nums[i])max = nums[i];
			sum+=nums[i];
		}
		if(m == 1)return sum;
		if(m>nums.length)return -1;
        int low = max;
        int high = sum;
		int ans = 0;
		while(low<=high) { // O(MAX-MIN+1)
			int mid = low + (high-low)/2;
			int cntStu = getCntStudent(nums,mid);
			if(cntStu > m) {
				low=mid+1;
			}else {
				high = mid-1;
			}
		}
		
		return low;
//Brute TC = O(N) + (O(N)*O(MAX-MIN+1)) SC = O(1)
