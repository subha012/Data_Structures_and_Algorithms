class Solution {
    public int findPeakElement(int[] nums) {
        //OPtimal TC = O(LogN) SC = O(1) If nums[mid] > nums[mid+1] → a peak lies on the left (including mid) Else → a peak lies on the right as the array will be like a graph increasing decreaing manner so the value will always found.
        int n = nums.length;
		if(n == 1)return 0;
		int low = 0,high = n-1;
		while(low<high) {
			int mid = low+(high-low)/2;
			if(nums[mid]>nums[mid+1])high = mid;
			else low = mid+1;
		}
		return low;

