class Solution {

    private int getMaxElementIndex(int[][] mat, int mid) {
		int max = Integer.MIN_VALUE;
		int index =-1;
		for(int i =0;i<mat.length;i++) {
			if(mat[i][mid]>max) {
				max = mat[i][mid];
				index = i;
			}
		}
		return index;
	}
	public int[] findPeakGrid(int[][] mat) {
        //Optimal TC = O(MlogN) SC = O(1)
		int n = mat.length;
		int m = mat[0].length;
		int low = 0;
		int high = m-1;
		while(low<=high) {
			int mid = low+(high -low)/2;
			int row = getMaxElementIndex(mat,mid);
			int left = mid-1>=0?mat[row][mid-1]:Integer.MIN_VALUE;
			int right = mid+1<m?mat[row][mid+1]:Integer.MIN_VALUE;
			if(left<mat[row][mid] && mat[row][mid]>right)return new int[] {row,mid};
			else if(left > mat[row][mid])high = mid-1;
			else low = mid+1;
		}
		return new int[]{-1,-1};
