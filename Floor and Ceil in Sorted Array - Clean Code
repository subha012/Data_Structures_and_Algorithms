class Solution {
// TC -O(LogN) SC = O(1)
    public int findFloor(int[] nums,int x){ 
		int ans = -1;
		int low= 0,high = nums.length-1;
		while(low<=high) {
			int mid = low + (high - low) / 2;
			if(nums[mid]<= x) {
				ans = nums[mid];
				low = mid+1;
			}else {
				high = mid-1;
			}
		}
		return ans;
	}
	public int findCeil(int[] nums,int x) {
		int ans = -1;
		int low = 0,high = nums.length-1;
		while(low<=high) {
			int mid = low + (high - low) / 2;
			if(nums[mid]>= x) {
				ans = nums[mid];
				high = mid-1;
			}else {
				low = mid+1;
			}
		}
		return ans;
	}
	public int[] getFloorAndCeil(int[] nums, int x) {
		int [] ans = new int[2];
		
		ans[0] = findFloor(nums, x);
		ans[1] = findCeil(nums, x);	
		
		return ans;
	       
    }
}
