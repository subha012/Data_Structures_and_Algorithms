class Solution {
    public int searchInsert(int[] nums, int target) {
        //Optimal Binary Search TC = O(LOGN) SC =O(1)
        int ans = nums.length;
        int low = 0;
        int high = nums.length-1;
        while(low<=high) {
        	int mid =(low+high)/2;
        	if(nums[mid]>=target) {
        		ans = mid;
        		high = mid-1;
        	}else {
        		low=mid+1;
        	}
        }
        return ans;
