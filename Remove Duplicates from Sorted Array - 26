class Solution {
    public int removeDuplicates(int[] nums) {

        //Optimal TC = O(n) SC = O(1)
        int index=1;
        if(nums.length == 0)return 0;
       
        for(int i =1;i<nums.length;i++){
            if(nums[i] != nums[i-1]){
                nums[index] = nums[i];
                index++;
            }
        }
        return index;


